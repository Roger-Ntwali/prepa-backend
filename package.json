{
  "name": "prepa-backend",
  "version": "0.1.0",
  "description": "PREPA - AI-Powered Offline Exam Preparation Platform - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node --dns-result-order=ipv6first src/server.js",
    "dev": "nodemon --exec \"node --dns-result-order=ipv6first\" src/server.js",
    "migrate": "node --dns-result-order=ipv6first db/migrate.js",
    "seed": "node --dns-result-order=ipv6first db/seed.js",
    "pretest": "cross-env DATABASE_URL=postgres://prepa_user:prepa_pass@localhost:5432/prepa_test node db/migrate.js",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
