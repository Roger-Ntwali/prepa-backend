# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgres://prepa_user:prepa_pass@localhost:5432/prepa_db

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Signs short-lived /uploads download links (past-paper PDFs). Falls back to
# JWT_SECRET if unset; set a separate value in production so a leaked
# download link secret can't also forge login tokens.
UPLOADS_SECRET=change_this_to_a_different_long_random_string

# AI Tutoring (LLM API) — Google Gemini, used by src/utils/gemini.js for
# the AI tutor, question-answer drafting, and PDF question import.
# gemini-flash-latest currently resolves to a "thinking" model version
# (confirmed via usageMetadata.thoughtsTokenCount ~644 per reply, 6-9s
# response times) -- gemini-flash-lite-latest resolves to a non-thinking
# variant, confirmed ~1.9s for the same prompt with no thoughtsTokenCount
# at all. Revert to gemini-flash-latest if answer quality ever matters more
# than latency for a given deployment.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
